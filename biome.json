{
  "$schema": "https://biomejs.dev/schemas/2.3.5/schema.json",
  "files": {
    "includes": [
      "packages/eta-mu-extensions/**/*.ts",
      "packages/eta-mu-extensions/**/*.mjs",
      "packages/eta-mu-runtime/**/*.ts",
      "packages/eta-mu-github/**/*.ts",
      "packages/coding-agent/src/**/*.ts",
      "packages/coding-agent/test/**/*.ts",
      "packages/presence-core/**/*.ts",
      "packages/kanban/**/*.ts",
      "packages/signal-*/**/*.ts",
      "packages/agent/**/*.ts",
      "packages/ai/**/*.ts",
      "packages/tui/**/*.ts",
      "packages/chat-ui/src/**/*.ts",
      "packages/chat-ui/src/**/*.tsx",
      "scripts/**/*.mjs",
      "biome.json",
      "package.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedVariables": "warn",
        "noUnusedImports": "warn"
      },
      "a11y": {
        "noAutofocus": "off",
        "useButtonType": "warn",
        "noStaticElementInteractions": "off",
        "useKeyWithClickEvents": "off",
        "useSemanticElements": "off",
        "useAriaActivedescendantWithTabindex": "off",
        "useValidAriaRole": "off"
      },
      "style": {
        "noNonNullAssertion": "warn"
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noControlCharactersInRegex": "off",
        "noAssignInExpressions": "off",
        "noArrayIndexKey": "off"
      },
      "complexity": {
        "noUselessFragments": "off"
      }
    },
    "includes": [
      "packages/eta-mu-extensions/**/*.ts",
      "packages/eta-mu-extensions/**/*.mjs",
      "packages/eta-mu-runtime/**/*.ts",
      "packages/eta-mu-github/**/*.ts",
      "packages/coding-agent/src/**/*.ts",
      "packages/coding-agent/test/**/*.ts",
      "packages/presence-core/**/*.ts",
      "packages/kanban/**/*.ts",
      "packages/signal-*/**/*.ts",
      "packages/agent/**/*.ts",
      "packages/ai/**/*.ts",
      "packages/tui/**/*.ts",
      "packages/chat-ui/src/**/*.ts",
      "packages/chat-ui/src/**/*.tsx",
      "scripts/**/*.mjs"
    ]
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*.spec.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    }
  ]
}
