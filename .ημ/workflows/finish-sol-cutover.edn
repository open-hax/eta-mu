   :stage/max-attempts 4
   :stage/review {:lenses ["correctness" "architecture-law"] :votes 2 :quorum 2}
   :stage/review-context "Implementation UNCOMMITTED in the working tree of /home/err/spaces/eta-mu. Inspect with: git -C /home/err/spaces/eta-mu diff -- packages/sol packages/turn-processor. Judge against the card's delivered scope."
   :stage/commit {:paths ["packages/sol" "packages/turn-processor" "kanban/tasks/sol-turn-processor-session-adapter.md"]
                  :message "sol: turn-processor session adapter (IAgentSession over run-loop)"}}

