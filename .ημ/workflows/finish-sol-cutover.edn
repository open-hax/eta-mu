{:workflow/id :finish-sol-cutover
 :workflow/version 1
 :workflow/source {:provider :opencode
                   :epic "kanban/epics/sol-turn-processor-cutover.md"
                   :requested-by "user 2026-07-17: start an ultra code workflow to finish the epic"}

 :meta {:name "finish-sol-cutover"
        :description "Implement the sol-turn-processor-cutover epic: 6 cards, implement -> gates -> review-wave -> repair -> promote, sequentially."
        :phases [{:title "Implement" :detail "per-card bounded packets"}
                 {:title "Review" :detail "adversarial lenses per landed card"}]}

 :run {:model "kimi-for-coding/k3"
       :dir "/home/err/spaces/eta-mu"
       :agent-timeout-ms 1800000
       :max-concurrency 4}

 :vars {:repo "/home/err/spaces/eta-mu"}

 :lens-prompts {:correctness "Hunt for real correctness bugs: logic errors, race conditions, broken edge cases, error paths that swallow or misreport failures, async bugs in ^:async/await code."
                :architecture-law "Audit against the repo constitution in AGENTS.md: I/O only behind extern.* namespaces; domain.*/law.* pure; law schemas enforced at boundaries; no utils namespaces; zero-warning contract; modern ^:async style (no promise chains/core.async)."
                :dod-coverage "Verify every Definition-of-done checkbox on the card against the actual code and tests. For each DoD item, name the exact test or evidence that satisfies it, or flag it unmet."}

 :review-prompt "You are reviewing a ClojureScript change in the eta-mu repo ({repo}) against its kanban card.\n\nCard: read {card/path} in full (including comment history — earlier reviews may have already fixed things; do not re-report fixed items).\nRepo rules: read {repo}/AGENTS.md.\n{card/context}\n\nYour lens: {lens/prompt}\n\nRead the actual source files (and tests) relevant to your lens. Report ONLY findings that would matter to a maintainer deciding whether to promote this card from review to done. Do not report style preferences the repo doesn't legislate. If the dod-coverage lens, also fill dodVerdict with the per-item evidence table."

 :verify-prompt "A code reviewer claims the following about the eta-mu repo ({repo}), card {card/path}:\n\nTITLE: {finding/title}\nFILE: {finding/file}\nCLAIM: {finding/detail}\nSEVERITY CLAIMED: {finding/severity}\n\nSkeptic pass #{vote/n}: try to REFUTE this. Read the actual code and card (including comment history — the card may already document this as an accepted tradeoff or fixed item). Refute if: the claim is factually wrong, the behavior is deliberate and documented, it is out of the card's delivered scope, or it is too minor to gate a review promotion. Default to refuted=true if uncertain."

 :schemas
 {:findings {:type "object"
             :additionalProperties false
             :properties {:findings {:type "array"
                                     :items {:type "object"
                                             :additionalProperties false
                                             :properties {:title {:type "string"}
                                                          :file {:type "string"}
                                                          :detail {:type "string"}
                                                          :severity {:type "string" :enum ["blocker" "should-fix" "nit"]}}
                                             :required ["title" "file" "detail" "severity"]}}
                          :dodVerdict {:type "string"}}
             :required ["findings" "dodVerdict"]}
  :verdict {:type "object"
            :additionalProperties false
            :properties {:refuted {:type "boolean"}
                         :reason {:type "string"}}
            :required ["refuted" "reason"]}}

