import fs from 'node:fs';
import { EtaMuActorsPlugin } from './.opencode/dist/eta-mu-actors.js';

const expected = [
  'actor_list',
  'actor_mailbox',
  'actor_monitor',
  'agent_list',
  'muse_phases',
  'phase_conclusions',
  'phase_filter',
  'phase_head',
  'phase_list_active',
  'phase_list_idle',
  'phase_observations',
  'phase_tail',
  'review_begin',
  'review_read_diff_chunk',
  'review_assess_diff_chunk',
  'review_classify_finding',
  'review_propose_finding',
  'review_record_evidence',
  'review_status',
  'review_submit',
  'task_list',
  'task_status',
].sort();

const config = JSON.parse(fs.readFileSync('.opencode/opencode.json', 'utf8'));
const permissionNames = Object.keys(config.permission ?? {}).sort();
if (JSON.stringify(permissionNames) !== JSON.stringify(expected)) {
  throw new Error(`Unexpected permission registry: ${JSON.stringify(permissionNames)}`);
}
for (const name of permissionNames) {
  if (config.permission[name] !== 'allow') {
    throw new Error(`Observer permission is not allow: ${name}`);
  }
}

const plugin = await EtaMuActorsPlugin({});
const runtimeNames = Object.keys(plugin.tool ?? {}).sort();
if (JSON.stringify(runtimeNames) !== JSON.stringify(expected)) {
  throw new Error(`Unexpected runtime tool registry: ${JSON.stringify(runtimeNames)}`);
}
fs.writeFileSync('.opencode/exposed-tools.txt', `${runtimeNames.join('\n')}\n`);
