{:source-paths ["src/cljs" "test/cljs"]
 :dependencies [[metosin/malli "0.16.4"]]
 :nrepl {:port 9001}
 :builds
 {:test
  {:target :node-test
   ;; .cjs so node runs it as CommonJS under this package's "type":"module".
   :output-to "dist/test.cjs"
   :ns-regexp "-test$"
   :autorun true}

  ;; katamorph is consumed via CLJS source-path by other packages, so this esm
  ;; build is for external JS consumers. It exports the manifest grammar — the
  ;; package's front door ("data as interpreter": namespace file -> resources).
  ;; (esm :exports is a map of name->var, never a set of namespaces.)
  :lib
  {:target :esm
   :runtime :node
   :output-dir "dist/lib"
   :modules {:lib {:exports {:isNamespaceFile katamorph.manifest/namespace-file?
                             :namespaceFileDefinitions katamorph.manifest/namespace-file-definitions
                             :qualifiedId katamorph.manifest/qualified-id
                             :qualifiedIdStr katamorph.manifest/qualified-id-str
                             :entryKinds katamorph.manifest/entry-kinds
                             :facetKinds katamorph.manifest/facet-kinds
                             :anonymousFacets katamorph.manifest/anonymous-facets}}}
   :js-options {:js-provider :import}
   :compiler-options
   {:output-feature-set :es-next
    :optimizations :simple
    :source-map true
    :infer-externs false}}}}
