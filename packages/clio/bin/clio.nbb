#!/usr/bin/env nbb

(ns clio.bin
  (:require [clio.external.js.process :as process]
            [clio.infra.cli :as cli]))

(try
  (apply cli/-main (process/argv))
  (catch :default cause
    (binding [*out* *err*]
      (println (ex-message cause))
      (when-let [data (ex-data cause)]
        (prn data)))
    (process/exit! 1)))
