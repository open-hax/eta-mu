{
  "name": "@eta-mu/session-mycology",
  "version": "0.1.0",
  "description": "Session reflection, lesson, spore, incubation, and promotion records",
  "type": "module",
  "private": false,
  "files": [
    "dist-cljs",
    "resources",
    "README.md"
  ],
  "main": "./dist-cljs/index.js",
  "exports": {
    ".": {
      "import": "./dist-cljs/index.js"
    }
  },
  "scripts": {
    "metadata": "node ../../scripts/generate-ledger-metadata.mjs",
    "build": "pnpm metadata && shadow-cljs release session-mycology",
    "prepublishOnly": "pnpm build",
    "test": "pnpm metadata && shadow-cljs compile test && node target/session-mycology-test.cjs",
    "lint:kondo": "clj-kondo --lint src/cljs test/cljs",
    "watch": "pnpm metadata && shadow-cljs watch session-mycology",
    "clean": "rm -rf dist-cljs target .shadow-cljs"
  },
  "devDependencies": {
    "shadow-cljs": "^3.4.11"
  },
  "license": "GPL-3.0-or-later"
}
