{
  "name": "eta-mu",
  "version": "0.1.0",
  "description": "Global eta-mu / pi CLI entry point and sub-command router",
  "type": "module",
  "private": false,
  "files": [
    "dist-cli",
    "README.md"
  ],
  "bin": {
    "eta-mu": "dist-cli/index.cjs",
    "pi": "dist-cli/index.cjs"
  },
  "scripts": {
    "build": "shadow-cljs release cli",
    "prepublishOnly": "pnpm build",
    "clean": "rm -rf dist-cli target .shadow-cljs",
    "test": "shadow-cljs compile test \u0026\u0026 node target/eta-mu-test.cjs",
    "lint:kondo": "clj-kondo --lint src/cljs test/cljs",
    "watch": "shadow-cljs watch cli"
  },
  "dependencies": {
    "get-east-asian-width": "^1.3.0"
  },
  "devDependencies": {
    "@eta-mu/contracts-output": "workspace:*",
    "@eta-mu/terminal-ui": "workspace:*",
    "@eta-mu/turn-processor": "workspace:*",
    "@open-hax/rheos": "workspace:*",
    "shadow-cljs": "^3.4.11"
  },
  "license": "GPL-3.0-or-later"
}
