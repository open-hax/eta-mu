;; eta-mu-extensions — canonical shadow-cljs build config
;; All paths are relative to packages/eta-mu-extensions/.
;; Outputs go to target/runtime/<name>/runtime.js (gitignored).
;; DO NOT regenerate this file from build.mjs — it is source-controlled.
;; To add an extension: add a .cljs file under src/, add a build entry here.
{:source-paths ["src" "lib"]

 :builds
 {
  ;; ── Extensions ───────────────────────────────────────────────────────

  :apply-patch
  {:target :node-library
   :output-to "target/runtime/apply-patch/runtime.js"
   :exports {:default eta-mu.build.apply-patch/init}
   :compiler-options {:externs ["externs/promise.js"]}}

  :bootstrap
  {:target :node-library
   :output-to "target/runtime/bootstrap/runtime.js"
   :exports {:default eta-mu.build.bootstrap/init}
   :compiler-options {:externs ["externs/promise.js"]}}

  :chronos
  {:target :node-library
   :output-to "target/runtime/chronos/runtime.js"
   :exports {:default eta-mu.build.chronos/init}
   :compiler-options {:externs ["externs/promise.js"]}}

  :contract-runtime
  {:target :node-library
   :output-to "target/runtime/contract-runtime/runtime.js"
   :exports {:default eta-mu.build.contract-runtime/init}
   :compiler-options {:externs ["externs/promise.js"]}}

  :contract-runtime-v2
  {:target :node-library
   :output-to "target/runtime/contract-runtime-v2/runtime.js"
   :exports {:default eta-mu.build.contract-runtime-v2/init}
   :compiler-options {:externs ["externs/promise.js"]}}

  :custom-providers
  {:target :node-library
