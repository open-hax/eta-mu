   :output-to "target/runtime/task-timing/runtime.js"
   :exports {:default eta-mu.build.task-timing/init}
   :compiler-options {:externs ["externs/promise.js"]}}

   :websearch-open-hax
   {:target :node-library
    :output-to "target/runtime/websearch-open-hax/runtime.js"
    :exports {:default eta-mu.build.websearch-open-hax/init}
    :compiler-options {:externs ["externs/promise.js"]}}

   ;; ── OpenCode targets ─────────────────────────────────────────────────

   :opencode-apply-patch
   {:target :esm
    :output-dir "target/opencode/apply-patch"
    :modules {:plugin {:exports {:default eta-mu.build.opencode.apply-patch/init}}}
    :js-options {:js-provider :import}
    :compiler-options {:optimizations :simple}}

   :opencode-bootstrap
   {:target :esm
    :output-dir "target/opencode/bootstrap"
    :modules {:plugin {:exports {:default eta-mu.build.opencode.bootstrap/init}}}
