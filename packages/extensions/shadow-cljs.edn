  :receipt-river
  {:target :node-library
   :output-to "target/runtime/receipt-river/runtime.js"
   :exports {:default eta-mu.build.receipt-river/init}
   :compiler-options {:externs ["externs/promise.js"]}}

  :session-mycology
  {:target :node-library
   :output-to "target/runtime/session-mycology/runtime.js"
   :exports {:default eta-mu.build.session-mycology/init}
   :compiler-options {:externs ["externs/promise.js"]}}

  :task-timing
