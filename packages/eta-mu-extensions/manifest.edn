;; eta-mu extension manifest
;; This file declares all extensions installed in this eta-mu runtime.
;; The build script reads this to resolve sources before compilation.
;;
;; Source types:
;;   :local   - A file on the local filesystem (relative to this file or absolute)
;;   :github  - A file in a GitHub repository
;;   :npm     - A file inside an npm package
;;
;; State directory: all extension runtime state goes into ~/.ημ/state/<name>/

{:version 1

 ;; Where compiled runtimes and build artifacts go
 :build-dir ".build"

 ;; Where extension runtime state is persisted (relative to ~/.ημ/)
 :state-dir "state"

 ;; Deployment targets
 :deploy
 {:pi       "~/.pi/agent/extensions/cljs-<name>/"
  :opencode "~/.config/opencode/plugins/<name>/"}

 ;; Declared extensions
 :extensions
 [;; Core constitutional primitives (tracked in git)
  {:name    "receipt-river"
   :source  :local
   :path    "src/eta_mu/extensions/receipt_river.cljs"
   :tracked true
   :description "Append-only receipts.log ledger for multi-step work"}

  {:name    "session-mycology"
   :source  :local
   :path    "src/eta_mu/extensions/session_mycology.cljs"
   :tracked true
   :description "Per-turn retrospection with p-scores and skill spore incubation"}

  {:name    "contract-runtime"
   :source  :local
   :path    "src/eta_mu/extensions/contract_runtime.cljs"
   :tracked true
   :description "Operational contract runtime with fulfillment-score evaluation"}

  {:name    "opmf-contract-gate"
   :source  :local
   :path    "src/eta_mu/extensions/opmf_contract_gate.cljs"
   :tracked true
   :npm-deps ["@open-hax/output-contract-gate"]
   :description "Output contract gate enforcement with auto-repair"}

  ;; Supporting extensions (tracked in git)
  {:name    "bootstrap"
   :source  :local
   :path    "src/eta_mu/extensions/bootstrap.cljs"
   :tracked true
   :description "Session initialization and state recovery"}

  {:name    "chronos"
   :source  :local
   :path    "src/eta_mu/extensions/chronos.cljs"
   :tracked true
   :description "Time tracking for contracting work"}

  {:name    "custom-providers"
   :source  :local
   :path    "src/eta_mu/extensions/custom_providers.cljs"
   :tracked true
   :description "Provider configuration extensions"}

  {:name    "image-render"
   :source  :local
   :path    "src/eta_mu/extensions/image_render.cljs"
   :tracked true
   :description "Image rendering for TUI"}

  {:name    "opencode-global-instructions"
   :source  :local
   :path    "src/eta_mu/extensions/opencode_global_instructions.cljs"
   :tracked true
   :description "Global instruction injection for OpenCode"}

  {:name    "task-timing"
   :source  :local
   :path    "src/eta_mu/extensions/task_timing.cljs"
   :tracked true
   :description "Task timing and performance tracking"}

  {:name    "websearch-open-hax"
   :source  :local
   :path    "src/eta_mu/extensions/websearch_open_hax.cljs"
   :tracked true
   :description "Web search via OpenHax proxy"}

