{ :source-paths ["src"
                "../../../openplanner/packages/openplanner-protocols/src"
                "../../../openplanner/packages/event-ledger/src"
                "../chat-ui/src"]
 :repositories {"clojars" {:url "https://repo.clojars.org/"}}
 :dependencies [[lilactown/helix "0.2.2"]
                [metosin/malli "0.16.4"]]
 :nrepl {:port 8799}
 :dev-http {8800 "resources/public"}
 :builds
 { :server {:target :node-script
           :output-to "dist/server.js"
           :main eta-mu.kanban.server/main
           :devtools {:watch-dir "resources"}}

 :server-dev {:target :node-script
              :output-to "dist/server-dev.js"
              :main eta-mu.kanban.server/main
              :js-options {:js-provider :shadow}
              :devtools {:autoload true
                         :watch-dir "resources"}}

 :cli {:target :node-script
       :output-to "dist/cli.js"
       :main eta-mu.kanban.cli/main
       :devtools {:watch-dir "resources"}}

 :app {:target :browser
       :output-dir "dist/web/js"
       :asset-path "/js"
       :modules {:main {:init-fn eta-mu.kanban.ui.core/init
                        :preloads [preloads.env]}}
       :js-options {:js-provider :shadow}
       :devtools {:after-load eta-mu.kanban.ui.core/dev-reload}}

 :test {:target :node-test
        :output-to "dist/test.js"
        :ns-regexp "-test$"
        :js-options {:js-provider :shadow}
        :autorun true}}}
