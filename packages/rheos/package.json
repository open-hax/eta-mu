{
  "name": "@eta-mu/rheos",
  "version": "0.1.0",
  "description": "Agent-first kanban board: CLI, server, MCP tools, and web UI",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "files": [
    "dist",
    "resources/public"
  ],
  "bin": {
    "rheos": "dist/cli.cjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "shadow-cljs release server cli app",
    "watch": "shadow-cljs watch server-dev",
    "start": "node dist/server.js",
    "start:dev": "node dist-dev/server.js",
    "test": "shadow-cljs compile test && node dist/test.cjs",
    "lint": "clj-kondo --lint src test",
    "lint:kondo": "clj-kondo --lint src test",
    "clean": "rm -rf dist dist-dev target"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/static": "^8.1.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chokidar": "^4.0.3",
    "fastify": "^5.3.3"
  },
  "devDependencies": {
    "@open-hax/protocols": "workspace:*",
    "@open-hax/uxx-helix": "^0.1.0",
    "@vitejs/plugin-react": "^6.0.2",
    "dompurify": "^3.4.10",
    "helix": "^0.3.1",
    "marked": "^18.0.5",
    "process": "^0.11.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "scheduler": "^0.23.2",
    "shadow-cljs": "^3.4.10",
    "ws": "^8.20.1"
  }
}
