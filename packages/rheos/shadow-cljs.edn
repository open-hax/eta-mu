{ :source-paths ["src" "test"
                "../protocols/src"
                "../chat-ui/src"]
 :repositories {"clojars" {:url "https://repo.clojars.org/"}}
 :dependencies [[lilactown/helix "0.2.2"]
                [metosin/malli "0.16.4"]]
 :nrepl {:port 8799}
 ;; Unique watch HTTP port. The shadow default (9630) is held by knoxx's
 ;; backend watch, so pin Rheos's own port so hot-reload attaches cleanly.
 :http {:port 9634}
 :dev-http {8800 "resources/public"}
 :builds
 { :server {:target :esm
            :runtime :node
            :output-dir "dist"
            :modules {:server {:init-fn rheos.backend.infra.http-server/init}}
            :js-options {:js-provider :import}
            ;; Bare JS interop throughout (req.query, .readFile, fastify .patch/.post);
            ;; :advanced renames those and breaks every handler. Pin :simple — output
            ;; size is irrelevant for a node process.
            :compiler-options {:optimizations :simple
                               :infer-externs false}}

  ;; CLI stays node-script → .cjs so node runs it as CommonJS under "type":"module".
  ;; It needs no hot reload, and emitting .cjs sidesteps the esm two-entrypoint rule.
  :cli {:target :node-script
        :output-to "dist/cli.cjs"
        :main rheos.backend.infra.cli/main
        :compiler-options {:optimizations :simple}}

  :server-dev {:target :esm
               :runtime :node
               :output-dir "dist-dev"
               :modules {:server {:init-fn rheos.backend.infra.http-server/init}}
               :js-options {:js-provider :import}
               ;; Hot reload: the node-esm client connects to the watch; before a
               ;; reload we close the HTTP listener (freeing the port) and re-listen
               ;; after, while the durable file watchers + project state survive.
               :devtools {:autoload true
                          :preloads [shadow.cljs.devtools.client.node-esm]
                          :before-load-async rheos.backend.infra.http-server/stop-http-before-load!
                          :after-load-async rheos.backend.infra.http-server/start-http-after-load!}
               :compiler-options {:optimizations :none
                                  :infer-externs false}}

  :app {:target :browser
        :output-dir "dist/web/js"
        :asset-path "/js"
        :modules {:main {:init-fn rheos.ui.infra.mount/init
                         :preloads [preloads.env]}}
        :js-options {:js-provider :shadow}
        :devtools {:after-load rheos.ui.infra.mount/dev-reload}}

  :test {:target :node-test
         ;; .cjs so node treats the test bundle as CommonJS under "type":"module".
         :output-to "dist/test.cjs"
         :ns-regexp "-test$"
         :autorun true}}}
