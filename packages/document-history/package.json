{
  "name": "@eta-mu/document-history",
  "version": "0.1.0",
  "description": "Clio-backed immutable document revisions and EDN/Markdown projections",
  "type": "module",
  "license": "LGPL-3.0-or-later",
  "files": [
    "src",
    "deps.edn",
    "nbb.edn",
    "README.md"
  ],
  "dependencies": {
    "fs-ext-extra-prebuilt": "2.2.9",
