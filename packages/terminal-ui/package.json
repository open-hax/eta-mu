{
  "name": "@eta-mu/terminal-ui",
  "version": "0.1.0",
  "description": "ClojureScript terminal UI components and host for the eta-mu agent",
  "type": "module",
  "private": false,
  "files": [
    "dist-cljs",
    "README.md"
  ],
  "main": "./dist-cljs/index.js",
  "exports": {
    ".": {
      "import": "./dist-cljs/index.js"
    }
  },
  "scripts": {
    "build": "shadow-cljs release terminal-ui",
    "clean": "rm -rf dist-cljs target .shadow-cljs",
    "test": "shadow-cljs compile test && node target/terminal-ui-test.cjs",
    "lint:kondo": "clj-kondo --lint src/cljs test/cljs",
    "watch": "shadow-cljs watch terminal-ui"
  },
  "dependencies": {
    "@eta-mu/turn-processor": "workspace:*"
  },
  "devDependencies": {
    "shadow-cljs": "^3.4.11"
  },
  "license": "GPL-3.0-or-later"
}
