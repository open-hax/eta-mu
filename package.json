{
  "name": "@open-hax/eta-mu-monorepo",
  "version": "0.1.0",
  "description": "Canonical eta-mu monorepo spanning GitHub automation, truth/docs kernels, Promethean runtime, and absorbed OpenHax surfaces",
  "private": false,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @open-hax/rheos watch",
    "build": "pnpm -r --no-bail build",
    "test": "pnpm --filter @open-hax/eta-mu-runtime test && pnpm --filter @open-hax/eta-mu-github test && pnpm --filter @open-hax/eta-mu-docs test && pnpm --filter @open-hax/kanban-legacy test",
    "typecheck": "pnpm --filter @open-hax/eta-mu-runtime typecheck && pnpm --filter @open-hax/eta-mu-github typecheck && pnpm --filter @open-hax/kanban-legacy exec tsc -p tsconfig.json --noEmit",
    "lint": "node scripts/lint.mjs",
    "lint:fix": "node scripts/lint.mjs --fix",
    "lint:kondo": "pnpm -r --no-bail --if-present lint:kondo",
    "docs:ts": "pnpm --filter @open-hax/eta-mu-cli doc",
    "docs:cljs": "clojure -X:codox",
    "docs": "pnpm docs:ts && pnpm docs:cljs",
    "coverage": "pnpm --filter @open-hax/eta-mu-runtime cljs:coverage",
    "start": "pnpm --filter @open-hax/rheos start",
    "clean": "pnpm --recursive clean",
    "install:all": "pnpm install && pnpm --recursive install",
    "ts:count": "node scripts/ts-line-count.mjs",
    "ts:count:global": "node scripts/ts-line-count.mjs --global",
    "ts:count:json": "node scripts/ts-line-count.mjs --json",
    "hooks:install": "ln -sf ../../scripts/pre-commit-ts-guard.sh .git/hooks/pre-commit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "@typescript/native-preview": "7.0.0-dev.20260120.1",
    "concurrently": "^8.2.2",
    "shx": "^0.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.14.0",
  "dependencies": {
    "@open-hax/eta-mu-monorepo": "link:"
  }
}
