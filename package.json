{
  "name": "@open-hax/eta-mu-monorepo",
  "version": "0.1.0",
  "description": "Canonical eta-mu monorepo spanning GitHub automation, truth/docs kernels, Promethean runtime, and absorbed OpenHax surfaces",
  "private": false,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @eta-mu/rheos watch",
    "build": "pnpm -r --no-bail build",
    "test": "bb scripts/test.bb",
    "typecheck": "pnpm --filter @open-hax/eta-mu-docs typecheck && pnpm --filter @open-hax/kanban-legacy exec tsc -p tsconfig.json --noEmit",
    "lint": "bb scripts/lint.bb",
    "lint:fix": "node scripts/lint.mjs --fix",
    "lint:kondo": "pnpm -r --no-bail --if-present lint:kondo",
    "docs:cljs": "clojure -X:codox",
    "docs": "pnpm docs:cljs",
    "start": "pnpm --filter @eta-mu/rheos start",
    "clean": "pnpm --recursive clean",
    "install:all": "pnpm install && pnpm --recursive install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "@typescript/native-preview": "7.0.0-dev.20260120.1",
    "concurrently": "^8.2.2",
    "shx": "^0.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.14.0",
  "dependencies": {
    "@open-hax/eta-mu-monorepo": "link:"
  }
}
