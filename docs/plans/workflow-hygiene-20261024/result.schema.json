{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed review semantics result v1 \u2014 shadow only",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_digest",
    "label",
    "evidence",
    "scope",
    "reason"
  ],
  "properties": {
    "schema": {
      "const": "review-semantics/v1"
    },
    "source_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "label": {
      "enum": [
        "approval",
        "changes-requested",
        "findings",
        "incomplete",
        "acknowledgement",
        "quota-unavailable",
        "retracted",
        "unknown"
      ]
    },
    "scope": {
      "enum": [
        "full-review",
        "partial-review",
        "unspecified"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start",
          "end",
          "text"
        ],
        "properties": {
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
